{
  "name": "LicoUp",
  "short_name": "LicoUp",
  "description": "Open-source, local-first Human-Agent Collaboration Client for people and AI agents.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#fbfaf8",
  "theme_color": "#fbfaf8",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
